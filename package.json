{
  "name": "modelquest",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "ModelQuest: a game for learning mathematical modeling and computational thinking",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "build": "python3 build.py",
    "build:vercel": "node scripts/build-vercel.js",
    "test": "node --test tests/gemini-import.test.js && node tests/run-all.js",
    "test:one": "node tests/bt.js"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0",
    "katex": "0.19.1",
    "mammoth": "1.11.0",
    "pdfjs-dist": "5.6.205",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
